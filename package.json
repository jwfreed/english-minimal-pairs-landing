{
  "name": "english-minimal-pairs-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:localized-homepages && npm run validate:content-routes && npm run validate:breadcrumbs",
    "build": "vite build",
    "postbuild": "npm run validate:breadcrumbs:dist && npm run validate:seo-architecture && npm run validate:internal-links",
    "generate:localized-homepages": "node scripts/generate-localized-homepages.mjs",
    "validate:content-routes": "node scripts/validate-content-route-registration.mjs",
    "validate:internal-links": "node scripts/validate-internal-links.mjs",
    "validate:seo-architecture": "node scripts/validate-seo-architecture.mjs",
    "validate:breadcrumbs": "node scripts/validate-breadcrumbs.mjs",
    "validate:breadcrumbs:dist": "node scripts/validate-breadcrumbs.mjs --dist",
    "validate:app-store-tracking": "node scripts/validate-app-store-tracking.mjs",
    "validate:exercise-engine": "node --test scripts/exercise-engine.test.mjs",
    "validate:funnel-tracking": "node scripts/validate-funnel-tracking.mjs",
    "validate:seo-conversion-matrix": "node scripts/validate-seo-page-conversion-matrix.mjs",
    "validate:seo-exercise": "node scripts/validate-seo-exercise.mjs",
    "preview": "vite preview",
    "validate:landing-copy": "node scripts/validate-landing-copy.mjs",
    "validate:localized-homepages": "node scripts/validate-localized-homepages.mjs",
    "validate:localized": "node scripts/validate-localized-seo-page.mjs",
    "deploy": "npm run build && touch dist/CNAME && echo 'getsoundwise.co' > dist/CNAME"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  }
}
